<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <!-- Indicador de arrastre -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#DDDDDD" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filtros de Búsqueda"
        android:textColor="#111111"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Distancia Máxima -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Distancia máxima:"
        android:textColor="#111111"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgDistanceEM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb1kmEM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 km" />

        <RadioButton
            android:id="@+id/rb5kmEM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="5 km" />

        <RadioButton
            android:id="@+id/rb10kmEM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="10 km" />
    </RadioGroup>

    <!-- Tipo de Servicio -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Servicios:"
        android:textColor="#111111"
        android:textSize="14sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/cbHaircutEM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="✂️ Corte de Cabello" />

    <CheckBox
        android:id="@+id/cbBeardEM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="🧔 Arreglo de Barba" />

    <CheckBox
        android:id="@+id/cbComboEM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💈 Combo VIP (Corte + Barba)" />

    <!-- Calificación Mínima -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Calificación mínima:"
        android:textColor="#111111"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgRatingEM"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbAnyRatingEM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Todas" />

        <RadioButton
            android:id="@+id/rb4StarEM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4.0 ★+" />

        <RadioButton
            android:id="@+id/rb45StarEM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4.5 ★+" />
    </RadioGroup>

    <!-- Botón Aplicar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyFiltersEM"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:text="APLICAR FILTROS"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:backgroundTint="#111111"
        app:cornerRadius="14dp" />

</LinearLayout>
